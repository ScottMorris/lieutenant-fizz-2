objects
  key-red id=red-key at=2.5,11.7  // the far left end of the chicken's ledge
  key-blue id=blue-key at=24.5,42.7  // the left end of the shelf
  cheezie id=hang-1 at=25.5,40.2  // two hang under the shelf
  cheezie id=hang-2 at=27.5,40.2
  cheezie id=shelf-cheezie at=27.5,42.7
  choc id=shelf-choc at=26.5,42.7
  cookie id=shelf-cookie at=25.5,42.7
  soda id=floor-can at=28.5,38.7  // in the shooting stretch by the right-hand wall
  soda id=shelf-can at=28.5,42.7
