script fizz2 0
// The slice level, Lighthouse Point, as a script. It lowers to the same LevelSource as `SLICE_SOURCE` in
// `crates/fizz-ep2/src/level.rs`, and the conformance test proves it by digest. Keep the two in step by hand.
level "Lighthouse Point" 32x48 id=light-1
start 2,2  // the lower-left corner of Ben's body
floor open

// Channels 1 and 2 are the red and blue doors; on is closed.
channel 1,2 on
lock red-door key=red at=15,21
lock blue-door key=blue at=22,39

map
  |......................B........B|  47
  |......................B........B|  46
  |......................B........B|  45
  |......................B........B|  44
  |......................B........B|  43
